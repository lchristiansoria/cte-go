# Configuracion local de desarrollo para CTG GO
ENV_APP=local

# PostgreSQL
HOST_DB=postgres
PORT_DB=5432
NAME_DB=cte_go
USR_DB=ctg_go_local
PASS_DB=ctg_go_db_2026_local

# RabbitMQ
HOST_RABBIT=rabbitmq
PORT_RABBIT=5672
VHOST_RABBIT=/
USR_RABBIT=ctg_go_local
PASS_RABBIT=ctg_go_rabbit_2026_local

# MinIO
USR_MINIO=ctggoadmin
PASS_MINIO=ctg_go_minio_2026_local

# Aplicacion
TOKEN_APP=ctg-go-local-token-2026
SECRET_APP=ctg-go-local-secret-2026

# Frontend y puertos locales
URL_API=http://api:8000
PORT_HTTP=80
PORT_HTTPS=443
PORT_FRONTEND=5173
PORT_API=8000
PORT_RABBIT_MGMT=15672
PORT_MINIO=9000
PORT_MINIO_CONSOLE=9001

